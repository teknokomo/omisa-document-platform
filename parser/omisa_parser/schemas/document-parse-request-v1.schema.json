{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omisa.invalid/schema/document-parse-request-v1.json",
  "title": "Omisa document_parse request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_ref"],
  "properties": {
    "artifact_ref": {"type": "string", "pattern": "^art_v1_[A-Za-z0-9_-]{22,128}$"},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ocr": {"enum": ["off", "auto", "force"], "default": "auto"},
        "language_hints": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 35}
        },
        "include": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["text", "tables", "notes", "comments", "metadata"]},
          "default": ["text", "tables", "notes"]
        },
        "range": {
          "type": "object", "additionalProperties": false,
          "required": ["unit", "start", "end"],
          "properties": {
            "unit": {"enum": ["page", "sheet", "slide"]},
            "start": {"type": "integer", "minimum": 1, "maximum": 100000},
            "end": {"type": "integer", "minimum": 1, "maximum": 100000}
          }
        },
        "max_records": {"type": "integer", "minimum": 1, "maximum": 500, "default": 200}
      }
    }
  }
}
