[Unit]
Description=Omisa break-glass parser broker connection %i
CollectMode=inactive-or-failed

[Service]
Type=exec
DynamicUser=yes
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeDirectory=omisa-parser-breakglass-jobs/%i
RuntimeDirectoryMode=0700
TemporaryFileSystem=/run/omisa-parser-breakglass-jobs:rw,nosuid,nodev,noexec,size=256M,nr_inodes=4096
TemporaryFileSystem=/work:rw,nosuid,nodev,noexec,size=224M,nr_inodes=64
UMask=0077
PrivateNetwork=yes
PrivateIPC=yes
PrivateDevices=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=default
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectKernelLogs=no
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=no
RemoveIPC=yes
KeyringMode=private
LimitCORE=0
LimitNOFILE=64
LimitNPROC=32
TasksMax=32
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
CPUQuota=150%
CPUQuotaPeriodSec=100ms
RuntimeMaxSec=95s
TimeoutStopSec=3s
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=kill
Slice=omisa-parser.slice
ExecStart=/usr/lib/omisa-parser/bin/omisa-parser-broker --systemd-stdio --allowed-uid=0 --runtime-dir=/run/omisa-parser-breakglass-jobs/%i
