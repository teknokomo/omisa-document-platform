[Unit]
Description=Omisa archive break-glass worker connection %i
CollectMode=inactive-or-failed

[Service]
Type=exec
DynamicUser=yes
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeDirectory=omisa-archive-breakglass-jobs/%i
RuntimeDirectoryMode=0700
TemporaryFileSystem=/run/omisa-archive-breakglass-jobs:rw,nosuid,nodev,noexec,size=96M,nr_inodes=1024
UMask=0077
PrivateNetwork=yes
PrivateIPC=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=default
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RemoveIPC=yes
KeyringMode=private
LimitCORE=0
LimitNOFILE=32
LimitNPROC=8
TasksMax=8
MemoryMax=256M
MemorySwapMax=0
CPUQuota=100%
RuntimeMaxSec=35s
TimeoutStopSec=3s
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=kill
Slice=omisa-parser.slice
ExecStart=/usr/lib/omisa-parser/bin/omisa-archive-broker 0 /run/omisa-archive-breakglass-jobs/%i
